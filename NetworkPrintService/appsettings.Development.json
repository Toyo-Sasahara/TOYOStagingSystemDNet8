{
  // 開発時に許可する Host ヘッダー（ローカル接続用）
  "AllowedHosts": "localhost;127.0.0.1;::1",
  // Kestrel(Webサーバー) の待受設定（開発用）
  "Kestrel": {
    // エンドポイント定義
    "Endpoints": {
      // HTTP待受ポート設定
      "Http": {
        // ローカルの5230番ポートで待受
        "Url": "http://localhost:5230"
      }
    }
  },
  // アプリケーションログ出力レベル設定（開発用）
  "Logging": {
    "LogLevel": {
      // 全体の既定ログレベル
      "Default": "Information",
      // ホスト起動/停止などライフサイクルログのレベル
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
