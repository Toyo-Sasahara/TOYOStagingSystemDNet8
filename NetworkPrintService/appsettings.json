{
  // Host ヘッダーで許可する接続先ホスト名（セミコロン区切り）
  "AllowedHosts": "CS1;CS2;CS3;CS4;CS5;CS6;DESK-00600",
  // Kestrel(Webサーバー) の待受設定
  "Kestrel": {
    // エンドポイント定義
    "Endpoints": {
      // HTTP待受ポート設定
      "Http": {
        // 0.0.0.0 で全NIC受信、5230番ポートで待受
        "Url": "http://0.0.0.0:5230"
      }
    }
  },
  // アプリケーションログ出力レベル設定
  "Logging": {
    "LogLevel": {
      // 全体の既定ログレベル
      "Default": "Information",
      // ホスト起動/停止などライフサイクルログのレベル
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  // テキストログ出力設定（Serilog）
  "Serilog": {
    // 利用するシンク（出力先）
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
    // 最小ログレベル設定
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    // 出力先設定
    "WriteTo": [
      {
        // コンソールへ出力
        "Name": "Console",
        "Args": {
          // コンソール表示のログ出力形式
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        // テキストファイルへ出力
        "Name": "File",
        "Args": {
          // 日次ローテーションファイル名（例: Logs/networkprint-20250101.log）
          "path": "Logs/networkprint-.log",
          // 日次でローテーション
          "rollingInterval": "Day",
          // 保持ファイル数上限（31世代）
          "retainedFileCountLimit": 31,
          // ファイルサイズ上限（10MB）
          "fileSizeLimitBytes": 10485760,
          // サイズ上限到達時に同日内ローテーション
          "rollOnFileSizeLimit": true,
          // サービス実行時のファイル共有有効化
          "shared": true,
          // 1行のログ出力形式
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
