<?xml version="1.0" encoding="utf-8"?>
<ArcSuiteTicketConfig xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <TYPE>ArcSuite属性設定</TYPE>
  <Params>
    <Param>
      <ArcSuiteAttrKeyName>entryMode</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>entity</ArcSuiteValueFormat>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>locationServiceId</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>ass1</ArcSuiteValueFormat>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>locationCabinetId</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>3e6f0b6f002b</ArcSuiteValueFormat>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>locationDrawerName</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>ZUMEN_DRA7</ArcSuiteValueFormat>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>editionKey</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>user:zuban "{0}"</ArcSuiteValueFormat>
      <StageServerDBKeyName>SANITIZEDPARTNUMBER</StageServerDBKeyName>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>name</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>{0}</ArcSuiteValueFormat>
      <StageServerDBKeyName>SANITIZEDPARTNUMBER</StageServerDBKeyName>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>updateSecondaryContent</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>system:view|system:print</ArcSuiteValueFormat>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>updateContentInformation</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>TRUE</ArcSuiteValueFormat>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>user:partname</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>{0}</ArcSuiteValueFormat>
      <StageServerDBKeyName>PARTSNAME</StageServerDBKeyName>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>user:zumensyurui</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>{0}</ArcSuiteValueFormat>
