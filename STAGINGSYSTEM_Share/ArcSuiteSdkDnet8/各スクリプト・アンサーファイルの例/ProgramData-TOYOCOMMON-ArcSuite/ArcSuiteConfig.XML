    </Param>
    <Param>
      <ArcSuiteAttrKeyName>user:description</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>{0}</ArcSuiteValueFormat>
      <StageServerDBKeyName>DESCRIPTION</StageServerDBKeyName>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>user:material</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>{0}</ArcSuiteValueFormat>
      <StageServerDBKeyName>MATERIAL</StageServerDBKeyName>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>user:sekkeisya</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>{0}</ArcSuiteValueFormat>
      <StageServerDBKeyName>DESIGNER</StageServerDBKeyName>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>user:customername</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>{0}</ArcSuiteValueFormat>
      <StageServerDBKeyName>FIRSTCUSTOMER</StageServerDBKeyName>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>user:customername</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>{0}</ArcSuiteValueFormat>
      <StageServerDBKeyName>CUSTOMER</StageServerDBKeyName>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>user:shireibangou</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>{0}</ArcSuiteValueFormat>
      <StageServerDBKeyName>ORDERNUMBER</StageServerDBKeyName>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>user:GuidCode</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>{0}</ArcSuiteValueFormat>
      <StageServerDBKeyName>GUID_RAW</StageServerDBKeyName>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>user:guidticketcode</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>{0}</ArcSuiteValueFormat>
      <StageServerDBKeyName>TICKETCODE</StageServerDBKeyName>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>user:model_name</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>{0}</ArcSuiteValueFormat>
      <StageServerDBKeyName>MACHINETYPE</StageServerDBKeyName>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>user:SourceApplication</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>{0}</ArcSuiteValueFormat>
      <StageServerDBKeyName>CREATESOFTWARE</StageServerDBKeyName>
    </Param>
    <Param>
      <ArcSuiteAttrKeyName>user:DrawingRevision</ArcSuiteAttrKeyName>
      <ArcSuiteValueFormat>{0}</ArcSuiteValueFormat>
      <StageServerDBKeyName>REV</StageServerDBKeyName>
    </Param>
  </Params>
  <!--StageServerDBKeyName：ステージサーバーデータベース上でのキー名
ArcSuiteAttrKeyName：ArcSuite SDKにて使用する 属性名
ArcSuiteValueFormat：ArcSuite SDKにて使用する 属性に対する書式。{0}にはDBKeryNameに該当する検索文字列が挿入-->
</ArcSuiteTicketConfig>